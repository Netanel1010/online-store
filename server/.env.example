# Copy to .env for local development: cp .env.example .env
# Every value has a default for development, so the file is optional there.

# development | test | production
NODE_ENV=development

# Port the API listens on. The Vite dev server uses 5173, so the API uses 3001.
PORT=3001

# Browser origins allowed to call the API (CORS), comma separated, no path and no trailing slash.
# The defaults below are the Vite dev server and `vite preview`. Required when NODE_ENV=production,
# for example: CORS_ORIGINS=https://netanel1010.github.io
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
