# Copy to .env for local development: cp .env.example .env
# Every value has a default for development, so the file is optional there.
# .env is git-ignored: keep real connection strings and passwords out of this example file.

# development | test | production
NODE_ENV=development

# Port the API listens on. The Vite dev server uses 5173, so the API uses 3001.
PORT=3001

# Browser origins allowed to call the API (CORS), comma separated, no path and no trailing slash.
# The defaults below are the Vite dev server and `vite preview`. Required when NODE_ENV=production,
# for example: CORS_ORIGINS=https://netanel1010.github.io
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# MongoDB. Leave MONGODB_URI unset (or empty) to run the API without a database in development.
# When it is set, the API connects before it starts listening and stops if it cannot connect.
# Required when NODE_ENV=production. Use ONE of these two forms, uncommented, in your own .env:
#
#   Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017
#
#   MongoDB Atlas (replace the placeholders; URL-encode special characters in the password):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Database to use (1-38 letters, digits, _ or -). The database in the connection string is ignored.
# Use a different name for each environment.
MONGODB_DB_NAME=online-store-dev

# How long to look for a reachable MongoDB at startup before giving up, in milliseconds (100-60000).
MONGODB_CONNECT_TIMEOUT_MS=5000
